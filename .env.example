# Copy to .env and fill in real values. Never commit .env or paste real keys into chat/prompts.

# ---- Supabase (one project) ----
# Public, safe to ship to web and mobile.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never ship to mobile. Used by web server actions, webhook, seed script.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web origin ----
# Used to build the QR payload: {WEB_ORIGIN}/b/{public_code}
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# ---- Stripe ----
# Server-only secret key (test mode: sk_test_...)
STRIPE_SECRET_KEY=
# Server-only webhook signing secret (whsec_...), from `stripe listen` or the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two paid plans (created in Stripe dashboard, test mode).
STRIPE_PRICE_CREW=
STRIPE_PRICE_COMPANY=
# Publishable key, safe to ship to web, needed by Stripe.js on the client during Checkout redirect.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Print (Diginate) ----
# Server-only. If unset, sticker orders fall back to a downloadable PDF instead of
# submitting to Diginate for physical printing/shipping.
DIGINATE_API_KEY=
DIGINATE_API_BASE_URL=https://api.diginate.com

# ---- Platform owner ----
# Seeded as the one platform_owner account. Owner logs in only at /admin/login.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# ---- Storage ----
# Supabase Storage bucket name for installer/foreman box photos.
SUPABASE_BOX_PHOTOS_BUCKET=box-photos
